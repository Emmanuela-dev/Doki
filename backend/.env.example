# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Google Maps and AI
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# PostgreSQL
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/doki

# File Storage (local dev or S3)
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=doki-uploads
AWS_REGION=eu-west-1

# App
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Kopo Kopo K2 Connect V2
KOPOKOPO_CLIENT_ID=
KOPOKOPO_CLIENT_SECRET=
KOPOKOPO_BASE_URL=https://api.kopokopo.com
KOPOKOPO_TILL_NUMBER=
PAYMENT_CALLBACK_URL=https://your-public-api.example.com/api/payments/kopokopo/callback
KOPOKOPO_API_VERSION=v2
KOPOKOPO_WEBHOOK_SECRET=
